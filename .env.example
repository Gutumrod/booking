# Shared environment configuration (copy to .env.local; never commit real secrets)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_ADMIN_SITE_URL=http://localhost:3001
NEXT_PUBLIC_BOOKING_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CENTRAL_LINE_OA_ID=@your-central-line-oa
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
# Server-only JSON map keyed by shop UUID. Never expose this as NEXT_PUBLIC_*.
LINE_MERCHANT_CHANNELS_JSON={"shop-uuid":{"channelSecret":"line-channel-secret","accessToken":"line-access-token"}}
NOTIFICATION_DISPATCH_SECRET=replace-with-a-long-random-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_PRICE_BASIC=price_monthly_basic
STRIPE_PRICE_PRO=price_monthly_pro

# BK01 shared-runtime migration runner (server/operator only; never expose to app clients)
BK01_MIGRATOR_DATABASE_URL=postgresql://bk01_migrator_login.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
BK01_SHARED_RUNTIME_ENV=local
# Required for lab/staging/production; leave empty only for local development.
BK01_EXPECTED_PROJECT_REF=
# Required by `npm run db:bk01:apply`; use an immutable release/change identifier.
BK01_RELEASE_ID=
