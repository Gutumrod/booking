# Shared environment configuration (copy to .env.local; never commit real secrets)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ADMIN_SITE_URL=
NEXT_PUBLIC_BOOKING_SITE_URL=
NEXT_PUBLIC_CENTRAL_LINE_OA_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Server-only JSON map keyed by shop UUID. Never expose this as NEXT_PUBLIC_*.
LINE_MERCHANT_CHANNELS_JSON=
NOTIFICATION_DISPATCH_SECRET=
HOUSE_RUNTIME_ISSUER_URL=
HOUSE_RUNTIME_AUDIENCE=
HOUSE_RUNTIME_CLIENT_ID=
HOUSE_RUNTIME_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
# BK01 Data API runtime identity (NOLOGIN role, short-lived JWT minted by the platform).
# There is no product database LOGIN and no product database password for BK01.
BK01_RUNTIME_ROLE=bk01_runtime

# BK01 shared-runtime migration runner (platform operator only; never exposed to app clients).
#
# Lane B criterion (b) / H2: a PRODUCT never holds a database credential for the shared
# project. The operator supplies their own platform session, and the runner narrows it to
# `bk01_migrator` with SET LOCAL ROLE inside the transaction. There is intentionally no
# `bk01_migrator_login` and no BK01-migrator password anywhere.
#
# Authenticate as a platform operator login (default allowlist: postgres). Never put a
# product credential here.
BK01_PLATFORM_DATABASE_URL=
# Comma-separated logins accepted as the platform operator. Defaults to `postgres`.
BK01_OPERATOR_LOGINS=postgres
BK01_SHARED_RUNTIME_ENV=
# Required for lab/staging/production; leave empty only for local development.
BK01_EXPECTED_PROJECT_REF=
# Required by `npm run db:bk01:apply`; use an immutable release/change identifier.
BK01_RELEASE_ID=
